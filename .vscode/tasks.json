{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Install All Dependencies",
      "type": "shell",
      "command": "npm install && npm run install-all",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "name": "Install Dependencies"
      },
      "problemMatcher": []
    },
    {
      "label": "🌱 Seed Database",
      "type": "shell",
      "command": "npm run seed",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "name": "Seed Database"
      },
      "problemMatcher": []
    },
    {
      "label": "🖥️ Start Backend Server",
      "type": "shell",
      "command": "npm run server",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "name": "Backend (Port 5001)"
      },
      "problemMatcher": []
    },
    {
      "label": "🌐 Start Frontend (React)",
      "type": "shell",
      "command": "npm run client",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "name": "Frontend (Port 5173)"
      },
      "problemMatcher": []
    },
    {
      "label": "✅ Start Full App (Backend + Frontend)",
      "dependsOrder": "parallel",
      "dependsOn": [
        "🖥️ Start Backend Server",
        "🌐 Start Frontend (React)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "name": "ShopEZ Full App"
      },
      "problemMatcher": []
    }
  ]
}
